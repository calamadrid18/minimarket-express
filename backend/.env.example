# Copia este archivo como ".env" y pon tus valores reales.
# El .env NO se sube a GitHub; este .env.example sí (sin secretos).

# Secreto para firmar los tokens (un texto largo y al azar). Lo usa Docker y también npm run dev.
JWT_SECRET=pon_aqui_un_texto_largo_y_secreto

# Solo hacen falta si corres el backend SIN Docker (npm run dev):
MONGODB_URI=mongodb://localhost:27018/minimarket
PORT=3002
# Páginas que pueden usar la API, separadas por comas
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173
